PORT = 3000

# =====================================================================
# Banco de dados relacional MySQL (base pittapong)
# =====================================================================
# Local: MySQL na propria maquina, sem SSL.
DB_HOST = localhost
DB_PORT = 3306
DB_USER = root
DB_PASSWORD = sua_senha_mysql
DB_NAME = pittapong

# Nuvem (Aiven): preencha com os dados do painel do servico.
# DB_HOST = seu-servico.aivencloud.com
# DB_PORT = 28745
# DB_USER = avnadmin
# DB_PASSWORD = sua_senha_aiven
# DB_NAME = pittapong

# =====================================================================
# TLS/SSL da conexao com o banco
# =====================================================================
# Ausente (ou "false") = conexao local sem SSL.
# Em nuvem o Aiven exige SSL: defina DB_SSL = true e coloque em DB_SSL_CA o
# conteudo do ca.pem baixado no console do Aiven.
# Em arquivo .env o valor multilinha precisa vir entre aspas duplas; no painel
# do Render basta colar o certificado como valor multilinha.
# DB_SSL = true
# DB_SSL_CA = "-----BEGIN CERTIFICATE-----
# MIIERDCCAqyg...
# -----END CERTIFICATE-----"

# =====================================================================
# Autenticacao JWT
# =====================================================================
# Use segredos diferentes entre local e producao.
JWT_SECRET = sua_jwt_secret

# =====================================================================
# Deploy
# =====================================================================
# URL publica da API. Alimenta o seletor de servidores do Swagger UI e os
# links retornados pela rota raiz. Ausente em ambiente local.
# API_PUBLIC_URL = https://sua-api.onrender.com

# Origens autorizadas pelo CORS, separadas por virgula (comparacao exata de
# protocolo + host + porta). Ausente em ambiente local libera qualquer origem.
# CORS_ORIGIN = https://seu-front.vercel.app
